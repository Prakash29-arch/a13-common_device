type hal_touchscreen_default, domain;
type hal_touchscreen_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_touchscreen_default)

# Touchscreen
allow hal_touchscreen_default sysfs_sec_touchscreen_writable:file rw_file_perms;

# /sys/class/sec/tsp/{cmd,cmd_result}
allow hal_touchscreen_default sysfs_sec_touchscreen_writable:dir r_dir_perms;
allow hal_touchscreen_default sysfs_touchscreen_writable:file r_file_perms;
# NOTE: the HAL also hits dac_override on these nodes. That is a DAC problem (owner/mode of
# the node), so it is not granted here: fix it in init rc (chown/chmod) instead.
